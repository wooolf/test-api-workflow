        {
          "name": "GET Invalid ID - 404 Error",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// This test will pass as we expect a 404",
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "// This test will fail as we're trying to parse an empty response as JSON",
                  "pm.test(\"FAILED: Parse empty response as JSON\", function () {",
                  "    try {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData).to.be.an('object');",
                  "    } catch (e) {",
                  "        pm.expect.fail('Failed to parse JSON: ' + e.message);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
