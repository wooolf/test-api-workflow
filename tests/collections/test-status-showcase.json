    {
      "name": "5. Skipped Tests",
      "item": [
        {
          "name": "GET Users - Conditionally Skipped",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Flag to control whether detailed tests run",
                  "const RUN_DETAILED_TESTS = false;",
                  "",
                  "// Conditionally skip the test",
                  "if (RUN_DETAILED_TESTS) {",
                  "    pm.test(\"Validate user email formats\", function () {",
                  "        const jsonData = pm.response.json();",
                  "        jsonData.forEach(user => {",
                  "            pm.expect(user.email).to.match(/^[\\w-\\.]+@([\\w-]+\\.)+[\\w-]{2,4}$/);",
                  "        });",
                  "    });",
                  "} else {",
                  "    console.log(\"SKIPPED: Detailed email validation tests\");",
                  "}",
                  "",
                  "// Explicitly marked as skipped in the name",
                  "pm.test(\"SKIP: Legacy user role validation\", function () {",
                  "    // This test is skipped because the feature was deprecated",
                  "    console.log(\"This test is for a deprecated feature\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/users",
              "protocol": "https",
              "host": [
                "jsonplaceholder",
                "typicode",
                "com"
              ],
              "path": [
                "users"
              ]
            },
            "description": "This request contains tests that are conditionally skipped"
          },
          "response": []
        }
      ]
